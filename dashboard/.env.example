# Copia este archivo a `dashboard/.env` y rellena lo que necesites.
# `dashboard/.env` está ignorado por Git: aquí no se sube ninguna credencial.

# ---------- Servidor ----------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# ---------- Descubrimiento de publicaciones ----------
# browser = lee x.com en tu Chrome (necesita playwright, ver requirements-dashboard.txt)
# nitter  = RSS de instancias públicas (sin dependencias, pero inestable)
# xapi    = API v2 oficial de X (de pago)
DASHBOARD_TIMELINE_PROVIDER=browser

# Cada cuántos segundos se revisan las cuentas activas (mínimo 60).
DASHBOARD_POLL_INTERVAL=900
DASHBOARD_POLL_ON_START=1

# Instancias Nitter para el proveedor de respaldo, separadas por comas.
DASHBOARD_NITTER_INSTANCES=https://nitter.kareem.one,https://nitter.privacyredirect.com

# x.com rechaza el modo oculto: déjalo en 0 y se abrirá una ventana de Chrome.
DASHBOARD_BROWSER_HEADLESS=0
DASHBOARD_BROWSER_CHANNEL=chrome

# Token de la API v2 de X (solo si usas DASHBOARD_TIMELINE_PROVIDER=xapi).
X_API_BEARER_TOKEN=

# ---------- Análisis / redacción ----------
# openai  = cualquier endpoint compatible con OpenAI (API oficial o modelo local)
# chatgpt = conduce chatgpt.com con tu sesión (experimental)
# manual  = sin IA, redactas tú
DASHBOARD_ANALYSIS_PROVIDER=openai

# API oficial:
DASHBOARD_OPENAI_BASE_URL=https://api.openai.com/v1
DASHBOARD_OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Modelo local, gratis y privado (ejemplos con Ollama o LM Studio):
#   DASHBOARD_OPENAI_BASE_URL=http://localhost:11434/v1
#   DASHBOARD_OPENAI_MODEL=llama3.1
#   OPENAI_API_KEY=local        (algunos servidores exigen cualquier valor)

DASHBOARD_ANALYSIS_TIMEOUT=120

# ---------- Telegram ----------
# Crea un bot con @BotFather y obtén el chat_id (por ejemplo con @userinfobot).
# El envío usa sendDocument, como exige la convención del repositorio.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Composición ----------
DASHBOARD_DEFAULT_FORMAT=auto
DASHBOARD_DEFAULT_FIT=auto
DASHBOARD_DEFAULT_STYLE=auto
DASHBOARD_DEFAULT_RESOLUTION=4k
DASHBOARD_DEFAULT_BACKEND=auto
